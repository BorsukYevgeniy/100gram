model File {
  name String @id

  fileType     FileType
  originalName String

  createdAt DateTime @default(now()) @db.Timestamptz

  // Attachments
  messageId Int?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  userAvatar    User? @relation("UserAvatar")
  chatAvatar    Chat? @relation("ChatAvatar")
  chatWallpaper Chat? @relation("ChatWallpaper")
}

enum FileType {
  ATTACHMENT
  USER_AVATAR
  CHAT_AVATAR
  CHAT_WALLPAPER
}
