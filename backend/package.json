{
  "name": "100gram",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:auth": "jest --config ./test/jest-e2e.json test/auth.e2e-spec.ts",
    "test:e2e:user": "jest --config ./test/jest-e2e.json test/user.e2e-spec.ts",
    "test:e2e:user:avatar": "jest --config ./test/jest-e2e.json test/user-avatar.e2e-spec.ts",
    "test:e2e:chat": "jest --config ./test/jest-e2e.json test/chat.e2e-spec.ts",
    "test:e2e:chat:avatar": "jest --config ./test/jest-e2e.json test/chat-avatar.e2e-spec.ts",
    "test:e2e:message": "jest --config ./test/jest-e2e.json test/message.e2e-spec.ts",
    "test:e2e:message:reaction": "jest --config ./test/jest-e2e.json test/message-reaction.e2e-spec.ts",
    "test:e2e:chat:message": "jest --config ./test/jest-e2e.json test/chat-message.e2e-spec.ts",
    "test:e2e:chat:member": "jest --config ./test/jest-e2e.json test/chat-member.e2e-spec.ts",
    "test:e2e:blocked:user": "jest --config ./test/jest-e2e.json test/blocked-user.e2e-spec.ts",
    "test:e2e:file": "jest --config ./test/jest-e2e.json test/file.e2e-spec.ts",
    "test:e2e:folder": "jest --config ./test/jest-e2e.json test/folder.e2e-spec.ts",
    "prisma:push:test": "cross-env NODE_ENV=test prisma db push",
    "prisma:generate:test": "cross-env NODE_ENV=test prisma generate",
    "prisma:studio:test": "cross-env NODE_ENV=test prisma studio",
    "prisma:migrate:dev": "cross-env NODE_ENV=dev prisma migrate dev",
    "prisma:generate:dev": "cross-env NODE_ENV=dev prisma generate",
    "prisma:studio:dev": "cross-env NODE_ENV=dev prisma studio",
    "docker:start:dev": "npm run prisma:generate:dev  && npm run start:dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "nestjs-asyncapi": "^2.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
