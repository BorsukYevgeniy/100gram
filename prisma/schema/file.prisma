model File {
  name String @id

  fileType FileType

  createdAt DateTime @default(now()) @db.Timestamptz

  // Attachments
  messageId Int?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  userAvatar User? @relation("UserAvatar")
  chatAvatar Chat? @relation("ChatAvatar")
}

enum FileType {
  ATTACHMENT
  USER_AVATAR
  CHAT_AVATAR
}
