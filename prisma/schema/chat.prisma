model Chat {
  id Int @id @default(autoincrement())

  title       String?
  description String?

  messages Message[] @relation("ChatMessages")

  lastMessageId Int?     @unique
  lastMessage   Message? @relation("LastMessage", fields: [lastMessageId], references: [id])

  chatToUsers ChatToUser[]

  chatType   ChatType
  visibility Visibility @default(PRIVATE)

  membersCount Int     @default(1)
  inviteToken  String? @unique

  avatarName String? @unique
  avatar     File?   @relation("ChatAvatar", fields: [avatarName], references: [name], onDelete: SetNull)

  /**
   * Private chats dont have owner, avatar, inviteToken, title and description.
   * He's visibility is private by default and cant be changed.
   */
}

enum ChatType {
  PRIVATE
  GROUP
  CHANNEL
}

enum Visibility {
  PUBLIC
  PRIVATE
}
